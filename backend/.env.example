# ---- Servidor ----
PORT=3000
CORS_ORIGIN=*
# URL pública de la API (se usa para construir URL firmadas de archivos)
PUBLIC_API_URL=http://localhost:3000/api/v1
# URL pública de la app web Flutter (QR de emergencia y verificación de récipes)
PUBLIC_WEB_URL=http://localhost:8080/#

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017/bewell

# ---- Redis (opcional). Si se omite, la caché de fichas QR usa memoria del proceso ----
# REDIS_URL=redis://localhost:6379

# ---- JWT ----
JWT_ACCESS_SECRET=cambia-esto-access
JWT_REFRESH_SECRET=cambia-esto-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Criptografía (base64 de 32 bytes: `openssl rand -base64 32`) ----
# Llave para cifrado a nivel de campo (AES-256-GCM) de datos clínicos
FIELD_ENCRYPTION_KEY=REEMPLAZAR_CON_32_BYTES_BASE64
# Llave maestra del KMS local que envuelve las llaves de firma ECDSA de los médicos
KMS_MASTER_KEY=REEMPLAZAR_CON_32_BYTES_BASE64
# Secreto para firmar URL de lectura de archivos (equivalente a URL prefirmadas)
URL_SIGNING_SECRET=cambia-esto-url

# ---- Almacenamiento de objetos (adapter local; S3 en sprints posteriores) ----
STORAGE_DIR=./storage

# ---- OCR: tesseract (real) | simulado (plantillas de demo) | vacío (todo queda como adjunto) ----
OCR_PROVIDER=tesseract

# ---- Pagos: paypal (PayPal sandbox, retención al reservar) | simulada (aprueba todo, sin dinero real) ----
PAGOS_PROVEEDOR=simulada
# Credenciales de una app REST de PayPal Developer (pestaña Sandbox): developer.paypal.com → Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (pruebas, sin dinero real) | live (producción)
PAYPAL_ENTORNO=sandbox

# ---- IA de exámenes: gemini (Google Gemini) | simulado (reglas por analitos y nombre, sin IA) | ninguno ----
IA_EXAMENES=simulado
# Clave de Google AI Studio (https://aistudio.google.com/app/apikey). Solo con IA_EXAMENES=gemini.
GEMINI_API_KEY=
# Opcional; por defecto gemini-2.5-flash
GEMINI_MODELO=
